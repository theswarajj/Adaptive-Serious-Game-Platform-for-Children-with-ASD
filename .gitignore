# =====================================================================
# Git Ignore Configuration for Adaptive Serious-Game Platform for ASD
# =====================================================================

# --- Node / JavaScript Dependencies & Build Artifacts ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
dist/
build/
.vite/
*.local

# --- Python & Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
venv_games/
*/venv_games/
*.py[cod]
*$py.class
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.installed.cfg
*.egg

# --- Machine Learning Caches, Checkpoints & Scratch Files ---
.ultralytics/
*/.ultralytics/
*/*/.ultralytics/
scratch/
*/scratch/
scratch_*.jpg
scratch_*.png
test_*.png
test_*.jpg
*.tmp

# --- Environment Secrets & Credentials ---
.env
.env.*
!.env.example
secrets.json

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# --- Runtime Logs & Database Journals ---
*.log
*.sqlite3-journal
*.db-journal
*.db-wal
*.db-shm

# Specifically exclude generator scripts
generate_readme.py
*/generate_readme.py
